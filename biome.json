{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/*.html",
      "!**/*.md",
      "!**/*.svg",
      "!pnpm-lock.yaml",
      "!pnpm-workspace.yaml",
      "!apps/server/assets",
      "!libs/crypto/src/lib/crux/qc_crux.js",
      "!libs/crypto/src/lib/crux/qc_crux.d.ts",
      "!libs/crypto/src/lib/crux/wasm.ts",
      "!libs/crypto/sodium/build",
      "!libs/crypto/sodium/libsodium",
      "!libs/crypto/sodium/libsodium-wrappers"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 3,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "useLiteralKeys": "off",
        "noImportantStyles": "off"
      },
      "style": {
        "useBlockStatements": "error",
        "noNonNullAssertion": "off",
        "useImportType": "off",
        "useArrayLiterals": "off",
        "useConsistentObjectDefinitions": "error"
      },
      "suspicious": {
        "noTsIgnore": "off"
      }
    }
  },
  "assist": {
    "enabled": false
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "yaml": {
    "formatter": {
      "bracketSpacing": true
    }
  },
  "overrides": [
    {
      "includes": ["**/*.json", "**/*.jsonc", "**/*.scss", "**/*.yml", "**/*.yaml"],
      "formatter": {
        "indentWidth": 2
      }
    },
    {
      "includes": ["**/*.spec.ts", "**/*.suite.ts", "apps/server/spec/**", "apps/web/tests/**", "apps/web/scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/web/tests/**"],
      "linter": {
        "rules": {
          "performance": {
            "useDomNodeTextContent": "off"
          }
        }
      }
    }
  ]
}
