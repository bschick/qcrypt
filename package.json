{
  "name": "@qcrypt/monorepo",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "check": "biome check --error-on-warnings",
    "check:fix": "biome check --write --error-on-warnings",
    "serve": "nx serve web --hmr false --host 0.0.0.0 --watch --poll 1000 --ssl --ssl-cert apps/web/localssl/localhost.crt --ssl-key apps/web/localssl/localhost.key",
    "test": "pnpm test:web && pnpm test:server && pnpm test:libs && pnpm test:cli",
    "build:web": "pnpm check && pnpm lint:e2e && node scripts/ensure-aaguids.mjs && NG_BUILD_OPTIMIZE_CHUNKS=1 nx build web --configuration test --output-path \"${QC_WEB_OUT:-dist/web-test}\" --subresource-integrity && node apps/web/scripts/validate-build.mjs \"${QC_WEB_OUT:-dist/web-test}/browser\"",
    "build:web:prod": "pnpm check && pnpm lint:e2e && node scripts/ensure-aaguids.mjs && NG_BUILD_OPTIMIZE_CHUNKS=1 nx build web --configuration production --output-path \"${QC_WEB_OUT:-dist/web}\" --subresource-integrity && node apps/web/scripts/validate-build.mjs \"${QC_WEB_OUT:-dist/web}/browser\"",
    "deploy:web": "apps/web/scripts/deploy.sh",
    "deploy:web:prod": "apps/web/scripts/deploy.sh --prod prod",
    "rollback:web": "apps/web/scripts/deploy.sh rollback",
    "rollback:web:prod": "apps/web/scripts/deploy.sh --prod prod rollback",
    "test:web": "nx test web",
    "test:web:watch": "nx test web --watch",
    "test:web:most": "nx test web --runnerConfig=apps/web/vitest-most.config.ts",
    "test:web:all": "nx test web --runnerConfig=apps/web/vitest-all.config.ts",
    "test:libs": "pnpm test:libs:crypto && pnpm test:libs:api",
    "test:libs:crypto": "nx test crypto",
    "test:libs:api": "nx test api",
    "lint:e2e": "eslint apps/web/tests",
    "test:e2e": "bash apps/web/scripts/run_e2e.sh --project local",
    "test:secrets": "bash apps/web/scripts/run_e2e.sh --project local --suite secrets",
    "test:fuzz": "QC_FULL_FUZZ=true pnpm exec vitest run --config apps/server/vitest.config.ts apps/server/spec/fuzz.spec.ts",
    "test:pentest": "QC_PENTEST=true pnpm exec vitest run --config apps/server/vitest.config.ts apps/server/spec/pentest.spec.ts",
    "test:e2e:prod": "node scripts/confirm-prod-waf.mjs bash apps/web/scripts/run_e2e.sh --project prod",
    "test:secrets:prod": "node scripts/confirm-prod-waf.mjs bash apps/web/scripts/run_e2e.sh --project prod --suite secrets",
    "test:fuzz:prod": "QC_ENV=prod QC_FULL_FUZZ=true node scripts/confirm-prod-waf.mjs pnpm exec vitest run --config apps/server/vitest.config.ts apps/server/spec/fuzz.spec.ts",
    "build:cli": "nx build cli",
    "build:cli:min": "nx build-min cli",
    "build:libs:crux": "node libs/crypto/crux/regen.mjs",
    "verify:libs:crux": "node libs/crypto/crux/regen.mjs --check",
    "build:libs:sodium": "node libs/crypto/sodium/regen.mjs",
    "verify:libs:sodium": "node libs/crypto/sodium/regen.mjs --check",
    "verify:proverif": "node formal/proverif/run.mjs",
    "test:cli": "nx test cli",
    "vectors:ciphers": "TSX_TSCONFIG_PATH=apps/web/scripts/tsconfig.json tsx apps/web/scripts/gen_ciphers_vectors.ts",
    "vectors:ciphersvc": "TSX_TSCONFIG_PATH=apps/web/scripts/tsconfig.json tsx apps/web/scripts/gen_ciphersvc_vectors.ts",
    "vectors:keys": "TSX_TSCONFIG_PATH=apps/web/scripts/tsconfig.json tsx apps/web/scripts/gen_keys_vectors.ts",
    "build:server": "node apps/server/scripts/build.mjs",
    "build:server:prod": "node apps/server/scripts/build.mjs --prod",
    "deploy:server": "apps/server/scripts/deploy.sh",
    "deploy:server:prod": "apps/server/scripts/deploy.sh --prod prod",
    "rollback:server:prod": "apps/server/scripts/deploy.sh --prod prod rollback",
    "test:server": "nx test server",
    "test:server:prod": "node scripts/confirm-prod-waf.mjs nx test-prod server",
    "test:timing": "nx test-timing server",
    "test:timing:prod": "node scripts/confirm-prod-waf.mjs nx test-timing-prod server",
    "svgo:flow": "bash apps/web/scripts/svgo_flow.sh"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@aws-sdk/client-dynamodb": "^3.1164.0",
    "@aws-sdk/client-kms": "^3.1164.0",
    "@inquirer/core": "^12.0.6",
    "@inquirer/prompts": "^8.7.5",
    "@scure/bip39": "^2.4.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "@zxcvbn-ts/matcher-pwned": "^4.1.3",
    "dompurify": "^3.4.17",
    "electrodb": "^3.9.3",
    "jsonwebtoken": "^9.0.3",
    "libsodium": "link:libs/crypto/sodium/libsodium",
    "libsodium-wrappers": "link:libs/crypto/sodium/libsodium-wrappers",
    "reopen-tty": "^1.1.2",
    "rxjs": "~7.8.2",
    "tslib": "^2.9.1",
    "xss": "^1.0.17",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@angular-devkit/core": "^22.2.6",
    "@angular-devkit/schematics": "^22.2.6",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@aws-sdk/types": "^3.975.0",
    "@biomejs/biome": "^2.6.6",
    "@nx/angular": "^24.0.5",
    "@nx/workspace": "^24.0.5",
    "@playwright/test": "^1.65.0",
    "@schematics/angular": "^22.2.6",
    "@types/aws-lambda": "^8.10.164",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.9",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/browser-playwright": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "nid-webauthn-emulator": "^0.2.17",
    "nx": "^24.0.5",
    "svgo": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
