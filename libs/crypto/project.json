{
  "name": "crypto",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "libs/crypto/src",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "pnpm exec tsc -p libs/crypto/tsconfig.lib.json --noEmit",
          "pnpm exec tsc -p libs/crypto/tsconfig.spec.json --noEmit"
        ],
        "cwd": "{workspaceRoot}",
        "parallel": false
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "dependsOn": ["typecheck"],
      "options": {
        "command": "pnpm exec vitest run --config libs/crypto/vitest.config.ts {args.include} -t \"{args.name}\"",
        "cwd": "{workspaceRoot}",
        "forwardAllArgs": false
      }
    }
  }
}
